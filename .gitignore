/data/*
!/data/README.md
!/data/iems/
!/data/iems/.gitkeep
!/data/base-targets/
!/data/base-targets/.gitkeep
!/data/targets/
!/data/targets/.gitkeep
**/__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
frontend/.next/
frontend/node_modules/
